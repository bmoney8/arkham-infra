{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Arkham Cockpit default capability: window show/hide/focus + shell open",
  "windows": ["main", "twenty"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "shell:allow-open"
  ]
}
